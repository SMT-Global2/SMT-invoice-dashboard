datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @map("_id") @default(auto()) @db.ObjectId
  firstName     String
  lastName      String
  username      String    @unique
  password      String
  visiblePassword String
  phoneNumber   String[]
  email         String?
  address       String?
  type          UserType  @default(USER)
  profileImage  String?
  aadhaarImage   String?
  sessionToken  String?   @default(uuid())
  gender        Gender    @default(NOT_SPECIFIED)
  employmentStatus EmploymentStatus @default(ACTIVE)
  exitType      ExitType?
  exitReason    String?
  employmentStart DateTime? @default(now())
  employmentEnd   DateTime?

  // invoice       Invoice[] @relation("InvoiceToUser")
  // check         Invoice[] @relation("CheckToUser")
  // package       Invoice[] @relation("PackageToUser")
  // pickup        Invoice[] @relation("PickupToUser")
  // delivery      Invoice[] @relation("DeliveryToUser")

  department    Department[]
  backups       Backup[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Add new relations
  attendance      Attendance[]
  markedAttendance Attendance[]    @relation("MarkedAttendance")
  salarySetting   SalarySetting?
  loans           Loan[]
  salaryPayments  SalaryPayment[]
  loanPayments    LoanPayment[]
}

model PartyCode {
    id           String    @id @map("_id") @default(auto()) @db.ObjectId
    code         String    @unique
    customerName String?
    city         String?
    regionalCode String?
    phoneNumber  String[]

    invoice Invoice[]
    deliveryMemo DeliveryMemo[]
    expiry Expiry[]
    receipt Receipt[]

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model AgencyCode {
    id           String    @id @map("_id") @default(auto()) @db.ObjectId
    code         String    @unique
    companyName  String?
    shortName    String?

    inventory Inventory[]
    agencyDeliveryMemos AgencyDeliveryMemo[]

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model AgencyDeliveryMemo {
  id            String    @id @map("_id") @default(auto()) @db.ObjectId
  adNumber      Int       @unique
  generatedDate DateTime

  agencyCode    String
  agency        AgencyCode @relation(fields: [agencyCode], references: [code], onDelete: NoAction)

  voucherNumber String?
  lrNumber      String?
  lrDate        DateTime

  image         String[]
  createdBy     String

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DayStartAgencyDeliveryMemo {
  id      String @id @map("_id") @default(auto()) @db.ObjectId
  date    String @unique
  startNo Int
  endNo   Int?
}

model Expiry {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId

  generatedDate     DateTime
  voucherNumber     String
  image             String[]

  partyCode         String    
  party             PartyCode  @relation(fields: [partyCode], references: [code] , onDelete: NoAction)

  expiryDate        DateTime
  expiryUsername    String
  expiryTimestamp   DateTime
  
  creditNoteNumber      String?
  creditNoteUsername    String?
  creditNoteTimestamp   DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt  
}

model DeliveryMemo {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId
  dmNumber          Int    @unique
  generatedDate     DateTime

  partyCode         String    
  party             PartyCode  @relation(fields: [partyCode], references: [code] , onDelete: NoAction)

  goodsCollectedUsername   String?
  goodsCollectedTimestamp  DateTime?

  goodsCheckedUsername   String?
  goodsCheckedTimestamp  DateTime?

  image             String[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Invoice {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId
  invoiceNumber     Int    @unique
  generatedDate     DateTime

  paymodeMode       PaymodeMode
  partyCode         String    
  party             PartyCode  @relation(fields: [partyCode], references: [code] , onDelete: NoAction)

  image             String[]
  isOtc             Boolean   @default(false)

  invoiceUsername   String?
  invoiceTimestamp  DateTime?
  // invoicedBy        User? @relation("InvoiceToUser", fields: [invoiceUsername], references: [username] , onDelete: NoAction)


  checkUsername     String?
  checkTimestamp    DateTime?
  // checkedBy         User? @relation("CheckToUser",fields: [checkUsername], references: [username] , onDelete: NoAction)
  checkStatus       CheckStatus @default(NOT_CHECKED)


  packageTimestamp  DateTime?
  packageUsername   String?
  // packedBy          User? @relation("PackageToUser",fields: [packageUsername], references: [username] , onDelete: NoAction)
  packageStatus     PackageStatus @default(NOT_PACKED)

  pickupUsername    String?
  pickupTimestamp   DateTime?
  // pickedUpBy        User? @relation("PickupToUser",fields: [pickupUsername], references: [username] , onDelete: NoAction)

  transportationId  String?    @db.ObjectId
  transportation    Transportation? @relation(fields: [transportationId], references: [id], onDelete: SetNull)

  deliveredUsername         String?
  deliveredTimestamp        DateTime?
  // deliveredBy               User? @relation("DeliveryToUser",fields: [deliveredUsername], references: [username] , onDelete: NoAction)
  deliveredLocationLink     String?
  deliveryStatus            DeliveryStatus @default(NOT_DELIVERED)

  billedUsername            String?
  billedTimestamp           DateTime?
  billedStatus              BilledStatus @default(NOT_BILLED)
  // billedBy                  User? @relation("BilledToUser",fields: [billedUsername], references: [username] , onDelete: NoAction)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Inventory {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId
  generatedDate     DateTime

  //Need for creating Inventory
  agencyCode        String
  agency            AgencyCode  @relation(fields: [agencyCode], references: [code] , onDelete: NoAction)
  invoiceNumber     String
  invoiceDate       DateTime
  dueDate           DateTime?
  
  lrNumber          String?
  lrDate            DateTime?
  through           String?
  packages          String?
  
  // Keeping these for backward compatibility but making them optional
  orderNumber       Int?
  orderDate         DateTime?
  
  inventoryCheckUsername   String?
  inventoryCheckTimestamp  DateTime?

  
  //Will be rows used input in 2nd table
  voucherNumber     Int?
  inventoryVoucherUsername   String?
  inventoryVoucherTimestamp  DateTime?
  image             String[]


  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt  
}


model Statement {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId

  name              String
  originalName      String
  uploadDate        DateTime  @default(now())
  statementDate     DateTime
  
  fileUrl           String?
  reportSections    ReportSection[]
  
  uploadedUsername  String?
  uploadedTimestamp DateTime?

  fileContent      Bytes?    // For storing the actual Excel file
  fileType         String?   // For storing the MIME type

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// The LastTwoPayment model represents uploaded payment history
model LastTwoPayment {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId
  name              String
  originalName      String
  uploadDate        DateTime  @default(now())
  paymentDate       DateTime  // Date for which the payment belongs to
  
  fileUrl           String?   // S3 key for the uploaded file
  paymentEntries    LastTwoPaymentEntry[]
  
  uploadedUsername  String?
  uploadedTimestamp DateTime?

  fileType          String?   // For storing the MIME type

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("LastTwoPayment")
}

/// The LastTwoPaymentEntry model stores entries for each payment
model LastTwoPaymentEntry {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId
  
  partyCode         String
  partyName         String
  location          String?
  contact           String?
  
  data              Json      // Store the payment entries data
  
  lastTwoPaymentId  String    @db.ObjectId
  lastTwoPayment    LastTwoPayment    @relation(fields: [lastTwoPaymentId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("LastTwoPaymentEntry")
}

model ReportSection {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId

  partyCode         String
  partyName         String
  location          String?
  contact           String?
  creditDays        String?
  
  data              Json
  
  // Saved data
  isSaved           Boolean   @default(false)
  savedTimestamp    DateTime?
  savedUsername     String?
  visitedBy         String?   // Field to track which user visited the party
  
  // Image data
  images            String[]
  
  // Location data
  latitude          Float?
  longitude         Float?
  address           String?

  statementId       String    @db.ObjectId
  statement         Statement  @relation(fields: [statementId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

type CurrencyBills {
  500 Int @default(0)
  200 Int @default(0)
  100 Int @default(0)
  50  Int @default(0)
  20  Int @default(0)
  10  Int @default(0)
}

type Cheque {
  number String?
  bank String?
  date DateTime?
  amount Int?
}

model Receipt {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId

  generatedDate     DateTime
  amount            Int
  remarks           String?

  receiptUsername   String?
  receiptTimestamp  DateTime?

  paymentMethod     PaymentMethod @default(NONE)

  receiptNumber     Int?
  currencyBills     CurrencyBills?
  
  cheque            Cheque?

  partyCode         String    
  party             PartyCode  @relation(fields: [partyCode], references: [code] , onDelete: NoAction)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}



model DayStartInvoice {
  id             String    @id @map("_id") @default(auto()) @db.ObjectId
  date           String    @unique
  invoiceStartNo Int
  invoiceEndNo   Int?
}

model UserDailyDenomination {
  id         String         @id @map("_id") @default(auto()) @db.ObjectId
  date       String
  username   String
  bills      CurrencyBills?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([date, username])
}

model InvoiceSequenceHistory {
  id           String   @id @map("_id") @default(auto()) @db.ObjectId
  date         String
  changedBy    String
  changedAt    DateTime @default(now())
  prevStartNo  Int
  prevEndNo    Int?
  newStartNo   Int
  newEndNo     Int?
  deletedCount Int      @default(0)
}

model DayStartDeliveryMemo {
  id             String    @id @map("_id") @default(auto()) @db.ObjectId
  date           String    @unique
  invoiceStartNo Int
  invoiceEndNo   Int?
}

enum PaymodeMode {
  CASH
  CREDIT
}

enum PaymentMethod {
  NONE
  CASH
  CHEQUE
}

enum UserType {
  ADMIN
  USER
}

enum Department {
  RECEIPT_MANAGEMENT
  INVOICE_MANAGEMENT
  PURCHASE_MANAGEMENT
  ATTENDANCE_MANAGEMENT
  DELIVERY_MEMO_MANAGEMENT
  ALL_ROUNDER
}

enum CheckStatus {
  NOT_CHECKED
  CHECKED
}

enum PackageStatus {
  NOT_PACKED
  PACKED
}

enum DeliveryStatus {
  NOT_DELIVERED
  PICKED_UP
  DELIVERED
}

enum BilledStatus {
  NOT_BILLED
  BILLED
}

enum DayStartType {
  INVOICE
  DELIVERY_MEMO
}

model ContactForm {
  id                String    @id @map("_id") @default(auto()) @db.ObjectId
  medicalName       String
  city             String?
  invoiceNumber    String
  issueType        String
  images           String[]
  comments         String?
  isUrgent         Boolean   @default(false)
  rating           Int?      @default(0)
  status           FormStatus @default(PENDING)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum FormStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model Transportation {
  id                String    @id  @map("_id") @default(auto()) @db.ObjectId
  companyName       String
  contactPersonName String?
  contactNumber     String
  email             String?
  city              String
  remarks           String?

  invoices          Invoice[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


enum BackupStatus {
  PENDING
  INPROGRESS
  COMPLETED
  FAILED
  CANCELED
}

model Backup {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  filename          String
  storageFilename   String?
  createdBy         String      @db.ObjectId
  fileSize          Int?
  status            BackupStatus @default(PENDING)
  progress          Int         @default(0)
  progressDetails   String?     // Store JSON string of progress details
  departments       String[]
  dateRange         Json?       // Store the date range
  filePath          String?
  completedAt       DateTime?
  downloadUrl       String?
  failureReason     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User          @relation(fields: [createdBy], references: [id])
}

enum AttendanceType {
  FULL_DAY
  HALF_DAY
  LATE
  ABSENT
}

model Attendance {
  id              String          @id @map("_id") @default(auto()) @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  type            AttendanceType
  notes           String?
  markedById      String          @db.ObjectId
  markedBy        User            @relation("MarkedAttendance", fields: [markedById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([userId, date], name: "userAttendanceDate")
}

model SalarySetting {
  id              String          @id @map("_id") @default(auto()) @db.ObjectId
  userId          String          @db.ObjectId @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary      Float
  allowances      Float
  taxes           Float
  lateDeductionRate Float         @default(0)
  halfDayDeductionRate Float      @default(0)
  absentDeductionRate Float       @default(0)
  salaryDate      Int             @default(1)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Loan {
  id              String          @id @map("_id") @default(auto()) @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  remainingAmount Float
  reason          String?
  issueDate       DateTime
  monthlyDeduction Float
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  payments        LoanPayment[]   // Add this relation to track payments
}

model LoanPayment {
  id              String          @id @map("_id") @default(auto()) @db.ObjectId
  loanId          String          @db.ObjectId
  loan            Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  paymentDate     DateTime        @default(now())
  salaryPaymentId String?         @db.ObjectId
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model SalaryPayment {
  id              String          @id @map("_id") @default(auto()) @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           Int             // 1-12
  year            Int             // e.g., 2023
  baseSalary      Float
  deductions      Float
  loanDeduction   Float
  netSalary       Float
  
  // Additional deduction details
  lateDeduction   Float?          @default(0)
  halfDayDeduction Float?         @default(0)
  absentDeduction Float?          @default(0)
  bonusPenalty    Float?          @default(0)
  
  // Attendance counts
  lateCount       Int?            @default(0)
  halfDayCount    Int?            @default(0)
  absentCount     Int?            @default(0)
  
  paymentDate     DateTime?
  isPaid          Boolean         @default(false)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([userId, month, year], name: "userMonthlySalary")
}

model TrackBoard {
  id            String         @id @map("_id") @default(auto()) @db.ObjectId
  name          String
  description   String?
  sections      TrackSection[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TrackSection {
  id            String         @id @map("_id") @default(auto()) @db.ObjectId
  name          String
  boardId       String         @db.ObjectId
  board         TrackBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  position      Int
  isFixedDay    Boolean        @default(false)
  cities        TrackCity[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model TrackCity {
  id            String         @id @map("_id") @default(auto()) @db.ObjectId
  name          String
  partyCode     String?
  sectionId     String         @db.ObjectId
  section       TrackSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  position      Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum Gender {
  MALE
  FEMALE
  NOT_SPECIFIED
}

enum EmploymentStatus {
  ACTIVE
  EX_EMPLOYEE
}

enum ExitType {
  RESIGNED
  TERMINATED
}